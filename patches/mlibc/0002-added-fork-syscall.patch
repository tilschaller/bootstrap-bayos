From 5ed30d41e78dc79c87c27b70d1d785051e2b895e Mon Sep 17 00:00:00 2001
From: Til Schaller <schaller.til@gmail.com>
Date: Sun, 13 Sep 2026 20:24:25 +0200
Subject: [PATCH 2/3] added fork syscall

---
 sysdeps/bayos/sysdeps.cpp | 6 ++++++
 1 file changed, 6 insertions(+)

diff --git a/sysdeps/bayos/sysdeps.cpp b/sysdeps/bayos/sysdeps.cpp
index e25e8f8c..358b47df 100644
--- a/sysdeps/bayos/sysdeps.cpp
+++ b/sysdeps/bayos/sysdeps.cpp
@@ -16,6 +16,7 @@
 #define SYS_WRITE 1
 #define SYS_ANON_ALLOCATE 2
 #define SYS_EXIT 3
+#define SYS_FORK 4
 
 namespace mlibc {
 
@@ -82,4 +83,9 @@ namespace mlibc {
     int sys_anon_free(void*, unsigned long) { return 0; }
 
     int sys_anon_allocate(unsigned long size, void** ptr) { auto result = syscall(SYS_ANON_ALLOCATE, size, ptr); return 0; }
+
+    int sys_fork(pid_t *child) {
+        *child = syscall(SYS_FORK);
+        return 0;
+    }
 }
